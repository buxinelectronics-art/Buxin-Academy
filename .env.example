# Buxin Academy — copy to .env and fill in real values

SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY_HOURS=168
FLASK_DEBUG=0
PORT=5000

DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-frontend-url,https://academy.techbuxin.com

ADMIN_EMAIL=admin@buxinev.com
ADMIN_PASSWORD=change-this-password

MODEMPAY_PUBLIC_KEY=pk_live_your_public_key
MODEMPAY_SECRET_KEY=sk_live_your_secret_key
MODEMPAY_WEBHOOK_SECRET=

FRONTEND_URL=https://academy.techbuxin.com
BACKEND_URL=https://buxin-academy.onrender.com

SOCKETIO_ASYNC_MODE=threading
